<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.laundryapp"> <!-- Ganti dengan nama paketmu -->

    <application android:allowBackup="true" android:icon="@mipmap/ic_launcher" android:label="@string/app_name" android:roundIcon="@mipmap/ic_launcher_round" android:supportsRtl="true" android:theme="@style/Theme.LaundryApp">

        <!-- Activity Laundry Per Kilo -->
        <activity
            android:name=".Activity_Laundry_Perkilo"
            android:exported="false" />

        <!-- Activity Home -->
        <activity
            android:name=".Activity_Home"
            android:exported="false" />

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Preloaded Fonts (opsional) -->
            <meta-data
                android:name="preloaded_fonts"
                android:resource="@array/preloaded_fonts" />
        </activity>

    </application>
</manifest>
